## 版本4，多实例共享权重内存！！！
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import time
import re
import io
import os
import base64
import asyncio
import threading
import json

from concurrent.futures import ThreadPoolExecutor
from contextlib import asynccontextmanager
from typing import Dict, List, Optional

import numpy as np
import soundfile as sf
import sherpa_onnx

from fastapi import FastAPI, HTTPException
from fastapi.responses import Response, StreamingResponse
from pydantic import BaseModel, Field
import uvicorn


# ============================================================
# 1. 服务配置
# ============================================================

# HTTP / 任务调度线程池大小
#
# 注意：
# 这里不再为每个线程创建一个 TTS 模型。
# executor worker 只是负责调度任务。
#MAX_CONCURRENT_WORKERS = 10

# ONNX Runtime 每一个 TTS 模型实例使用多少线程
#ONNX_NUM_THREADS = 4


MAX_CONCURRENT_WORKERS = int(
    os.getenv("MAX_CONCURRENT_WORKERS", "10")
)

ONNX_NUM_THREADS = int(
    os.getenv("ONNX_NUM_THREADS", "4")
)

# ============================================================
# 关键参数：每个音色创建多少个 OfflineTts 实例
#
# 例如：
# MODEL_POOL_SIZE = 1
#   male   = 1个模型实例
#   female = 1个模型实例
#
# MODEL_POOL_SIZE = 2
#   male   = 2个模型实例
#   female = 2个模型实例
#
# 如果设置为 2，总模型实例数 = 4。
#
# 强烈建议先测试：
#   1
#   2
#   4
#
# 不建议一上来设置很大。
# ============================================================

MODEL_POOL_SIZE = 10


# ============================================================
# 2. 模型配置
# ============================================================

 #VOICE_MODELS = {
 #    "male": {
 #        "dir": "./vits-piper-zh_CN-chaowen-medium",
 #        "onnx_name": "zh_CN-chaowen-medium.onnx",
 #    },
 #
 #    "female": {
 #        "dir": "./vits-piper-zh_CN-xiao_ya-medium",
 #        "onnx_name": "zh_CN-xiao_ya-medium.onnx",
 #
 #        # INT8版本示例
 #        # "dir": "./vits-piper-zh_CN-xiao_ya-medium-int8",
 #        # "onnx_name": "zh_CN-xiao_ya-medium.onnx",
 #    },
 #}
MODEL_ROOT = "/models"

VOICE_MODELS = {
    "male": {
        "dir": f"{MODEL_ROOT}/vits-piper-zh_CN-chaowen-medium",
        "onnx_name": "zh_CN-chaowen-medium.onnx",
    },

    "female": {
        "dir": f"{MODEL_ROOT}/vits-piper-zh_CN-xiao_ya-medium",
        "onnx_name": "zh_CN-xiao_ya-medium.onnx",
    },
}


DEFAULT_VOICE = "female"

# Piper 默认采样率
DEFAULT_SAMPLE_RATE = 22050


# ============================================================
# 3. 模型实例封装
# ============================================================

class TTSEngineInstance:
    """
    一个独立的 sherpa_onnx OfflineTts 实例。

    设计原则：
    1. 每个实例只创建一次
    2. 同一个实例同一时间只允许一个线程调用
    3. 不同实例之间可以并发推理

    这样既保证线程安全，又能真正利用多核 CPU。
    """

    def __init__(
        self,
        voice_id: str,
        model_dir: str,
        onnx_name: str,
        num_threads: int,
        instance_id: int,
    ):
        self.voice_id = voice_id
        self.instance_id = instance_id
        self.lock = threading.Lock()

        model_path = f"{model_dir}/{onnx_name}"
        tokens_path = f"{model_dir}/tokens.txt"
        lexicon_path = f"{model_dir}/lexicon.txt"

        self.model_path = model_path

        print(
            f"[Model Init] "
            f"voice={voice_id} "
            f"instance={instance_id} "
            f"model={model_path}"
        )

        tts_config = sherpa_onnx.OfflineTtsConfig(
            model=sherpa_onnx.OfflineTtsModelConfig(
                vits=sherpa_onnx.OfflineTtsVitsModelConfig(
                    model=model_path,
                    tokens=tokens_path,
                    lexicon=lexicon_path,
                ),
                num_threads=num_threads,
                debug=False,
            ),
            rule_fsts=(
                f"{model_dir}/phone.fst,"
                f"{model_dir}/date.fst,"
                f"{model_dir}/number.fst"
            ),
        )

        if not tts_config.validate():
            raise ValueError(
                f"TTS Config validation failed: "
                f"voice={voice_id}, instance={instance_id}"
            )

        self.engine = sherpa_onnx.OfflineTts(tts_config)

        print(
            f"[Model Init Done] "
            f"voice={voice_id} "
            f"instance={instance_id}"
        )

    def generate(
        self,
        text: str,
        sid: int,
        speed: float,
    ):
        """
        安全地执行一次 TTS。

        当前实例通过 lock 保证：
            一个 OfflineTts 实例 = 同时只能处理一个 generate。

        不同实例可以并发执行。
        """

        with self.lock:
            return self.engine.generate(
                text,
                sid=sid,
                speed=speed,
            )


# ============================================================
# 4. 模型池
# ============================================================

class TTSModelPool:
    """
    每个 voice 一个模型池。

    例如 MODEL_POOL_SIZE=2：

        female:
            instance 0
            instance 1

        male:
            instance 0
            instance 1

    总共 4 个 OfflineTts 实例。

    使用 round-robin + condition 的方式获取空闲实例。
    """

    def __init__(
        self,
        voice_id: str,
        config: dict,
        pool_size: int,
        num_threads: int,
    ):
        if pool_size < 1:
            raise ValueError("pool_size must be >= 1")

        self.voice_id = voice_id
        self.pool_size = pool_size
        self.num_threads = num_threads

        self.instances: List[TTSEngineInstance] = []
        self._available: List[int] = list(range(pool_size))

        self._condition = threading.Condition()
        self._next_rr = 0

        model_dir = config["dir"]
        onnx_name = config["onnx_name"]

        print(
            f"[Pool Init] "
            f"voice={voice_id} "
            f"pool_size={pool_size} "
            f"onnx_threads={num_threads}"
        )

        for instance_id in range(pool_size):
            instance = TTSEngineInstance(
                voice_id=voice_id,
                model_dir=model_dir,
                onnx_name=onnx_name,
                num_threads=num_threads,
                instance_id=instance_id,
            )

            self.instances.append(instance)

        print(
            f"[Pool Init Done] "
            f"voice={voice_id} "
            f"instances={len(self.instances)}"
        )

    def acquire(self) -> TTSEngineInstance:
        """
        获取一个空闲模型实例。

        如果所有实例都忙，则阻塞等待。
        """

        with self._condition:
            while not self._available:
                self._condition.wait()

            # round-robin 选择
            available_count = len(self._available)

            if available_count == 1:
                idx = 0
            else:
                idx = self._next_rr % available_count
                self._next_rr += 1

            instance_id = self._available.pop(idx)

            return self.instances[instance_id]

    def release(self, instance: TTSEngineInstance):
        """
        释放模型实例。
        """

        with self._condition:
            self._available.append(instance.instance_id)
            self._condition.notify()

    def generate(
        self,
        text: str,
        sid: int,
        speed: float,
    ):
        """
        获取实例 -> 推理 -> 释放实例
        """

        instance = self.acquire()

        try:
            return instance.generate(
                text=text,
                sid=sid,
                speed=speed,
            )
        finally:
            self.release(instance)

    def size(self) -> int:
        return len(self.instances)


# ============================================================
# 5. 全局模型池
# ============================================================

MODEL_POOLS: Dict[str, TTSModelPool] = {}


def init_model_pools():
    """
    服务启动时只调用一次。

    不再使用：
        threading.local()
        initializer=init_worker

    因此模型不再跟 ThreadPoolExecutor worker 绑定。
    """

    MODEL_POOLS.clear()

    print("=" * 70)
    print("[Model Pools] Start loading...")
    print(f"[Model Pools] pool_size={MODEL_POOL_SIZE}")
    print(f"[Model Pools] onnx_threads={ONNX_NUM_THREADS}")
    print("=" * 70)

    for voice_id, config in VOICE_MODELS.items():

        pool = TTSModelPool(
            voice_id=voice_id,
            config=config,
            pool_size=MODEL_POOL_SIZE,
            num_threads=ONNX_NUM_THREADS,
        )

        MODEL_POOLS[voice_id] = pool

    total_instances = sum(
        pool.size()
        for pool in MODEL_POOLS.values()
    )

    print("=" * 70)
    print(
        f"[Model Pools] Loaded successfully. "
        f"voices={len(MODEL_POOLS)}, "
        f"total_instances={total_instances}"
    )
    print("=" * 70)


# ============================================================
# 6. HTTP 任务线程池
# ============================================================

executor: Optional[ThreadPoolExecutor] = None


# ============================================================
# 7. API 数据模型
# ============================================================

class TTSRequest(BaseModel):
    text: str = Field(
        ...,
        description="需要合成的目标文本",
    )

    voice: str = Field(
        default=DEFAULT_VOICE,
        description="音色选择：male / female",
    )

    sid: int = Field(
        default=0,
        description="说话人 ID",
    )

    speed: float = Field(
        default=1.0,
        description="语速调节系数",
    )


# ============================================================
# 8. FastAPI 生命周期
# ============================================================

@asynccontextmanager
async def lifespan(app: FastAPI):

    global executor

    print("=" * 70)
    print("Starting TTS service...")
    print(f"MAX_CONCURRENT_WORKERS = {MAX_CONCURRENT_WORKERS}")
    print(f"ONNX_NUM_THREADS        = {ONNX_NUM_THREADS}")
    print(f"MODEL_POOL_SIZE         = {MODEL_POOL_SIZE}")
    print("=" * 70)

    # --------------------------------------------------------
    # 8.1 初始化模型池
    # --------------------------------------------------------

    init_model_pools()

    # --------------------------------------------------------
    # 8.2 初始化线程池
    #
    # 注意：
    # initializer 已经彻底取消。
    # 线程池不再加载模型。
    # --------------------------------------------------------

    executor = ThreadPoolExecutor(
        max_workers=MAX_CONCURRENT_WORKERS,
        thread_name_prefix="tts-worker",
    )

    # --------------------------------------------------------
    # 8.3 模型预热
    # --------------------------------------------------------

    print("[Warmup] Start...")

    warmup_text = "引擎预热。"

    loop = asyncio.get_running_loop()

    warmup_tasks = []

    warmup_count_per_voice = MODEL_POOL_SIZE

    for voice_id in VOICE_MODELS.keys():

        for _ in range(warmup_count_per_voice):

            warmup_tasks.append(
                loop.run_in_executor(
                    executor,
                    _generate_chunk_sync,
                    warmup_text,
                    voice_id,
                    0,
                    1.0,
                )
            )

    warmup_start = time.perf_counter()

    await asyncio.gather(*warmup_tasks)

    warmup_elapsed = time.perf_counter() - warmup_start

    print(
        f"[Warmup] Done. "
        f"elapsed={warmup_elapsed:.3f}s"
    )

    print("=" * 70)
    print("TTS service ready.")
    print("=" * 70)

    yield

    # --------------------------------------------------------
    # 8.4 关闭线程池
    # --------------------------------------------------------

    print("[Shutdown] Stopping executor...")

    if executor is not None:
        executor.shutdown(wait=True)

    print("[Shutdown] Done.")


app = FastAPI(
    title="VITS TTS Multi-Voice API",
    lifespan=lifespan,
)


# ============================================================
# 9. 文本切分
# ============================================================

def split_text_by_punctuation(text: str) -> list:
    """
    按中英文标点切分。

    这里保留你原来的策略，因为你已经实测验证：

        原策略 → RTF ≈ 0.0114

    所以暂时不改变。
    """

    pattern = r'([，。！？；,\.\!\?;]+)'

    chunks = re.split(pattern, text)

    sentences = []

    i = 0

    while i < len(chunks) - 1:

        sentence = (
            chunks[i].strip()
            + chunks[i + 1].strip()
        )

        if sentence:
            sentences.append(sentence)

        i += 2

    # 处理末尾无标点文本
    if i < len(chunks):

        tail = chunks[i].strip()

        if tail:
            sentences.append(tail)

    return sentences


# ============================================================
# 10. 单个 TTS chunk 推理
# ============================================================

def _generate_chunk_sync(
    text: str,
    voice: str,
    sid: int,
    speed: float,
):
    """
    在线程池中执行一条 TTS 推理。

    不再通过 thread_local 获取模型。

    而是：
        voice
          ↓
        MODEL_POOLS
          ↓
        获取空闲 OfflineTts 实例
          ↓
        generate()
          ↓
        归还实例
    """

    if voice not in MODEL_POOLS:
        raise ValueError(
            f"Voice '{voice}' is not loaded."
        )

    pool = MODEL_POOLS[voice]

    audio = pool.generate(
        text=text,
        sid=sid,
        speed=speed,
    )

    if len(audio.samples) == 0:
        return None, 0

    samples = np.asarray(
        audio.samples,
        dtype=np.float32,
    )

    return samples, audio.sample_rate


# ============================================================
# 11. 完整文件合成接口
# ============================================================

@app.post("/api/tts")
async def generate_tts(request: TTSRequest):

    # --------------------------------------------------------
    # 参数校验
    # --------------------------------------------------------

    if request.voice not in MODEL_POOLS:

        raise HTTPException(
            status_code=400,
            detail=(
                f"Invalid voice. "
                f"Supported: {list(MODEL_POOLS.keys())}"
            ),
        )

    if not request.text.strip():

        raise HTTPException(
            status_code=400,
            detail="Text cannot be empty.",
        )

    if request.speed <= 0:

        raise HTTPException(
            status_code=400,
            detail="speed must be > 0",
        )

    # --------------------------------------------------------
    # 文本切分
    # --------------------------------------------------------

    sentences = split_text_by_punctuation(
        request.text
    )

    if not sentences:

        raise HTTPException(
            status_code=400,
            detail="Text cannot be empty.",
        )

    # --------------------------------------------------------
    # 开始计时
    # --------------------------------------------------------

    total_start = time.perf_counter()

    loop = asyncio.get_running_loop()

    # --------------------------------------------------------
    # 提交任务
    # --------------------------------------------------------

    submit_start = time.perf_counter()

    tasks = [
        loop.run_in_executor(
            executor,
            _generate_chunk_sync,
            sentence,
            request.voice,
            request.sid,
            request.speed,
        )
        for sentence in sentences
    ]

    submit_elapsed = (
        time.perf_counter() - submit_start
    )

    # --------------------------------------------------------
    # 等待所有 chunk 完成
    # --------------------------------------------------------

    results = await asyncio.gather(*tasks)

    inference_elapsed = (
        time.perf_counter() - total_start
    )

    # --------------------------------------------------------
    # 合并音频
    # --------------------------------------------------------

    concat_start = time.perf_counter()

    all_samples = []

    out_sample_rate = DEFAULT_SAMPLE_RATE

    for samples, sample_rate in results:

        if samples is not None:

            all_samples.append(samples)
            out_sample_rate = sample_rate

    if not all_samples:

        raise HTTPException(
            status_code=500,
            detail="Failed to generate any audio.",
        )

    if len(all_samples) == 1:

        final_audio = all_samples[0]

    else:

        final_audio = np.concatenate(
            all_samples
        )

    concat_elapsed = (
        time.perf_counter() - concat_start
    )

    # --------------------------------------------------------
    # 性能统计
    # --------------------------------------------------------

    total_elapsed = (
        time.perf_counter()
        - total_start
    )

    duration = (
        len(final_audio)
        / out_sample_rate
    )

    rtf = (
        total_elapsed / duration
        if duration > 0
        else 0
    )

    realtime_speed = (
        duration / total_elapsed
        if total_elapsed > 0
        else 0
    )

    print(
        "\n"
        "[Complete TTS]\n"
        f"  Voice            : {request.voice}\n"
        f"  Chunks           : {len(sentences)}\n"
        f"  Characters       : {len(request.text)}\n"
        f"  Audio duration   : {duration:.3f}s\n"
        f"  Total elapsed    : {total_elapsed:.3f}s\n"
        f"  Inference elapsed: {inference_elapsed:.3f}s\n"
        f"  Submit elapsed   : {submit_elapsed:.6f}s\n"
        f"  Concat elapsed   : {concat_elapsed:.6f}s\n"
        f"  RTF              : {rtf:.4f}\n"
        f"  Realtime speed   : {realtime_speed:.2f}x\n"
    )

    # --------------------------------------------------------
    # WAV编码
    # --------------------------------------------------------

    wav_start = time.perf_counter()

    buffer = io.BytesIO()

    sf.write(
        buffer,
        final_audio,
        samplerate=out_sample_rate,
        subtype="PCM_16",
        format="WAV",
    )

    buffer.seek(0)

    wav_elapsed = (
        time.perf_counter() - wav_start
    )

    print(
        f"[WAV] encode={wav_elapsed:.6f}s"
    )

    return Response(
        content=buffer.getvalue(),
        media_type="audio/wav",
    )


# ============================================================
# 12. SSE 流式接口
# ============================================================

@app.post("/api/tts_sse")
async def generate_tts_sse(
    request: TTSRequest
):

    if request.voice not in MODEL_POOLS:

        raise HTTPException(
            status_code=400,
            detail=(
                f"Invalid voice. "
                f"Supported: {list(MODEL_POOLS.keys())}"
            ),
        )

    if not request.text.strip():

        raise HTTPException(
            status_code=400,
            detail="Text cannot be empty.",
        )

    if request.speed <= 0:

        raise HTTPException(
            status_code=400,
            detail="speed must be > 0",
        )

    sentences = split_text_by_punctuation(
        request.text
    )

    if not sentences:

        raise HTTPException(
            status_code=400,
            detail="Text cannot be empty.",
        )

    async def sse_generator():

        loop = asyncio.get_running_loop()

        total_start = time.perf_counter()

        for i, sentence in enumerate(sentences):

            chunk_start = time.perf_counter()

            samples, sample_rate = (
                await loop.run_in_executor(
                    executor,
                    _generate_chunk_sync,
                    sentence,
                    request.voice,
                    request.sid,
                    request.speed,
                )
            )

            chunk_elapsed = (
                time.perf_counter()
                - chunk_start
            )

            if samples is None or len(samples) == 0:
                continue

            # ------------------------------------------------
            # WAV编码
            # ------------------------------------------------

            wav_buffer = io.BytesIO()

            sf.write(
                wav_buffer,
                samples,
                samplerate=sample_rate,
                subtype="PCM_16",
                format="WAV",
            )

            wav_buffer.seek(0)

            wav_base64 = base64.b64encode(
                wav_buffer.getvalue()
            ).decode("utf-8")

            chunk_duration = (
                len(samples)
                / sample_rate
            )

            chunk_rtf = (
                chunk_elapsed / chunk_duration
                if chunk_duration > 0
                else 0
            )

            print(
                f"[SSE Chunk {i}] "
                f"voice={request.voice} "
                f"text='{sentence[:20]}...' "
                f"audio={chunk_duration:.3f}s "
                f"elapsed={chunk_elapsed:.3f}s "
                f"rtf={chunk_rtf:.4f}"
            )

            payload = {

                "chunk_index": i,

                "text": sentence,

                "voice_used": request.voice,

                "audio_base64": wav_base64,

                "audio_duration": chunk_duration,

                "rtf": chunk_rtf,

                "is_final": (
                    i == len(sentences) - 1
                ),
            }

            yield (
                "data: "
                + json.dumps(
                    payload,
                    ensure_ascii=False,
                )
                + "\n\n"
            )

        total_elapsed = (
            time.perf_counter()
            - total_start
        )

        print(
            f"[SSE Complete] "
            f"voice={request.voice} "
            f"chunks={len(sentences)} "
            f"elapsed={total_elapsed:.3f}s"
        )

    return StreamingResponse(
        sse_generator(),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "Connection": "keep-alive",
            "X-Accel-Buffering": "no",
        },
    )


# ============================================================
# 13. 健康检查接口
# ============================================================

@app.get("/health")
async def health_check():

    pool_info = {}

    for voice_id, pool in MODEL_POOLS.items():

        pool_info[voice_id] = {
            "pool_size": pool.size(),
        }

    return {
        "status": "ok",

        "config": {
            "max_workers": MAX_CONCURRENT_WORKERS,
            "onnx_num_threads": ONNX_NUM_THREADS,
            "model_pool_size": MODEL_POOL_SIZE,
        },

        "voices": pool_info,
    }


# ============================================================
# 14. 启动
# ============================================================

if __name__ == "__main__":

    uvicorn.run(
        "vits_tts_server:app",
        host="0.0.0.0",
        port=8000,
        workers=1,
        log_level="info",
    )
